
# ===== APPLICATION SETTINGS =====
NODE_ENV=development
APP_NAME=crypto-viz

# ===== SERVICE PORTS =====
WEB_SCRAPER_PORT=3001
ANALYTICS_BUILDER_PORT=3002
DYNAMIC_VIEWER_PORT=3000

# ===== CRYPTOCURRENCY APIs =====
# CoinGecko API (Free tier: 10-50 calls/minute)
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# CoinMarketCap API (Free tier: 333 calls/day)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# CryptoCompare API (Free tier: 100,000 calls/month)
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here
CRYPTOCOMPARE_BASE_URL=https://min-api.cryptocompare.com

# ===== DATABASE CONFIGURATION =====
# MongoDB
MONGODB_URI=mongodb://cryptovizuser:cryptovizpass@mongodb:27017/cryptoviz?authSource=admin
MONGODB_USER=cryptovizuser
MONGODB_PASSWORD=cryptovizpass
MONGODB_DATABASE=cryptoviz

# Redis (for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ===== KAFKA CONFIGURATION =====
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=crypto-viz
KAFKA_GROUP_ID=crypto-viz-group

# Kafka Topics
KAFKA_TOPIC_RAW_DATA=crypto-raw-data
KAFKA_TOPIC_ANALYTICS=crypto-analytics
KAFKA_TOPIC_ALERTS=crypto-alerts

# ===== SCRAPER CONFIGURATION =====
# Scraping intervals (in milliseconds)
SCRAPE_INTERVAL_PRICES=30000        # 30 seconds
SCRAPE_INTERVAL_NEWS=300000         # 5 minutes
SCRAPE_INTERVAL_SOCIAL=600000       # 10 minutes

# Rate limiting
MAX_API_CALLS_PER_MINUTE=50
API_RATE_LIMIT_WINDOW=60000

# Data retention
DATA_RETENTION_DAYS=30

# ===== ANALYTICS CONFIGURATION =====
# Processing windows
ANALYTICS_WINDOW_SHORT=300000       # 5 minutes
ANALYTICS_WINDOW_MEDIUM=3600000     # 1 hour
ANALYTICS_WINDOW_LONG=86400000      # 24 hours

# Thresholds for alerts
PRICE_CHANGE_ALERT_THRESHOLD=5      # 5% change
VOLUME_SPIKE_THRESHOLD=2            # 2x average volume
SENTIMENT_ALERT_THRESHOLD=0.8       # Strong sentiment score

# ===== SECURITY =====
JWT_SECRET=your_jwt_secret_key_here
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ===== MONITORING & LOGGING =====
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# Health check intervals
HEALTH_CHECK_INTERVAL=30000

# ===== EXTERNAL SERVICES =====
# News APIs
NEWS_API_KEY=your_news_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Social Media APIs (optional)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ===== DOCKER CONFIGURATION =====
# Container memory limits
SCRAPER_MEMORY_LIMIT=512m
ANALYTICS_MEMORY_LIMIT=1g
VIEWER_MEMORY_LIMIT=512m

# Network
DOCKER_NETWORK=crypto-viz-network

# ===== DEVELOPMENT SETTINGS =====
# Enable/disable features for development
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_LOGS=false
HOT_RELOAD=true

# Testing
TEST_API_DELAY=1000
MOCK_KAFKA_MESSAGES=false